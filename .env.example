# LandLens — environment variables
# Copy this file to .env.local for local dev. Never commit secrets.
# Production / Preview values live in Vercel Project Settings → Environment Variables.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                # safe to expose, anon key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                    # SERVER ONLY — never NEXT_PUBLIC
#
# Auth setup (do this once in the Supabase dashboard):
#   1. Auth → URL Configuration → Site URL = https://land.trenlens.com
#   2. Auth → URL Configuration → Redirect URLs: add
#        https://land.trenlens.com/auth/callback
#        http://localhost:3000/auth/callback   (for local dev)
#   3. Auth → Providers → enable Email (magic link) and Google
#   4. Set up Google OAuth credentials in GCP and paste client id/secret
#      into Supabase Auth → Providers → Google.

# Prisma connection string. Use the *pooled* (PgBouncer, port 6543) URL for the
# app and the *direct* (port 5432) URL for migrations only.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Upstash Redis (rate-limit + idempotency replay cache) ───────────────────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ── Map providers ───────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=                           # optional, MapTiler streets basemap

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://land.trenlens.com

# ── AI segmentation service (Phase 2 — leave empty in Phase 1) ──────────────
SEGMENTATION_SERVICE_URL=                            # https://landlens-seg.modal.run
SEGMENTATION_API_KEY=
GEE_SERVICE_ACCOUNT_KEY=                             # Google Earth Engine JSON, single-line
GEE_PROJECT_ID=

# ── AI-first architecture (Sprint 12 / 13) ──────────────────────────────────
MCP_SERVER_ADMIN_TOKEN=                              # long random string for MCP auth
VAULT_ENCRYPTION_KEY=                                # used by pgsodium for BYOK keys

# ── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET=                                         # rejects unauthorized cron pings

# ── Audit log hashed-IP salt ────────────────────────────────────────────────
# Combined with the current UTC month and the request IP, then SHA-256'd
# before writing to `access_log`. Rotate by changing this value — old hashes
# become uncorrelatable. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=82b1a7c2f9d4e6b8a1c3f5d7e9b2a4c6d8e1f3a5b7c9d2e4f6a8b1c3d5e7f9a2

# ── Commercial feature flags (Phase 2 — default false in Phase 1) ───────────
ENABLE_BULK_EXPORT_UNLIMITED=false
ENABLE_POSTGIS_DIRECT_ACCESS=false
ENABLE_ENCROACHMENT_DETECTION=false
ENABLE_WHITE_LABEL=false
